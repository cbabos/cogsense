{
	"compilerOptions": {
		"target": "es2025",
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": true
	}, 
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
